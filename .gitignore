# Force-include the ground-truth test fixture (a real MC 1.21.5 region
# file captured by the maintainer — see DECISIONS.md 2026-05-28). The
# enclosing `*.mca` rule would otherwise hide it from git.
!tests/fixtures/*.mca

# Force-include the Tier-4 manual-verification artifact (a deterministic
# .mca produced by tests/manual/generate_tier4_test_region.py; this is
# the file the maintainer loads into MC 1.21.5 to perform the in-game
# verification — see DECISIONS.md 2026-06-02). Same enclosing-rule
# carve-out as the fixture above.
!tests/manual/*.mca

# Force-include the Session 26 orchestration Tier-4 artifact (a complete
# vanilla-MC-1.21.5-loadable world directory; bunny voxelised end-to-end
# with deterministic now_unix_s=0 so the artifact is byte-stable across
# runs). maintainer copies this into ~/.minecraft/saves/ for the Session 28
# Tier-4 manual verification. See research/orchestration_proposal.md
# §3.13(g) + DECISIONS.md 2026-07-01 "Orchestration scope (v0.1)".
!tests/manual/orchestrate_tier4_world/
!tests/manual/orchestrate_tier4_world/level.dat
!tests/manual/orchestrate_tier4_world/region/
!tests/manual/orchestrate_tier4_world/region/*.mca

# Force-include the Session 30 Cornell Box multi-material Tier-4 artifact
# (same byte-deterministic-via-now_unix_s=0 pattern as the bunny artifact;
# closes the matcher emissive-branch end-to-end coverage gap left by the
# v0.1 Tier-4). maintainer copies this into ~/.minecraft/saves/ for the
# Session 31 Tier-4 manual verification. See research/cornell_box_tier4_
# proposal.md §3.8 + DECISIONS.md 2026-07-03 "Cornell Box multi-material
# Tier-4 scope (v0.2 work item #1)".
!tests/manual/cornell_box_tier4_world/
!tests/manual/cornell_box_tier4_world/level.dat
!tests/manual/cornell_box_tier4_world/region/
!tests/manual/cornell_box_tier4_world/region/*.mca

# Force-include the mesh-layer test fixtures (.obj files under
# tests/fixtures/mesh/ — hand-cube, two-material MTL, malformed input,
# Stanford bunny per proposal §5.10 + DECISIONS.md 2026-06-18 "Stanford
# bunny test fixture provenance"). The `*.obj` rule in the binary-
# artefacts block above is for compiler-emitted Windows object files,
# not Wavefront geometry; carve out the fixtures directory explicitly.
!tests/fixtures/mesh/*.obj

# Force-include the Cornell Box test fixture (Morgan McGuire's
# CornellBox-Original.obj + .mtl + LICENSE per Session 30 / DECISIONS.md
# 2026-07-03 "Cornell Box multi-material Tier-4 scope (v0.2 work item #1)").
# The `*.obj` rule above is for compiler-emitted Windows object files,
# not Wavefront geometry; carve out the fixtures directory explicitly.
!tests/fixtures/cornell_box/*.obj

# Force-include the hand-written transparent-branch test fixture
# (scene.obj + scene.mtl per Session 33 / DECISIONS.md 2026-07-04
# "Transparent branch Tier-4 scope (v0.2 work item #1.1)"). Same
# `*.obj` carveout rationale as the Cornell Box entry above.
!tests/fixtures/transparent/*.obj

# Force-include the Session 33 transparent-branch Tier-4 artifact
# (byte-deterministic via now_unix_s=0; maintainer copies this into
# ~/.minecraft/saves/ for the Session 34 Tier-4 manual verification).
# See research/transparent_tier4_proposal.md §3.8 + DECISIONS.md
# 2026-07-04 "Transparent branch Tier-4 scope (v0.2 work item #1.1)".
!tests/manual/transparent_tier4_world/
!tests/manual/transparent_tier4_world/level.dat
!tests/manual/transparent_tier4_world/region/
!tests/manual/transparent_tier4_world/region/*.mca

# Force-include the hand-written textured-quad fixture (quad.obj +
# quad.mtl + checker.png per Session 48 per-voxel texture sampling).
# Same `*.obj` carveout rationale as the entries above.
!tests/fixtures/texture/*.obj

# Force-include the vendored Crytek Sponza fixture (sponza.obj + sponza.mtl
# + copyright.txt + LICENSE per Session 36 / DECISIONS.md 2026-07-04
# "Scale Tier-4 scope (v0.2 work item #2)"). Same `*.obj` carveout
# rationale as the Cornell Box + transparent entries above.
!tests/fixtures/sponza/*.obj

# Force-include the Session 36 Sponza scale Tier-4 artifact
# (byte-deterministic via now_unix_s=0; 4 region files spanning
# positive + negative chunk coordinates; maintainer copies this into
# ~/.minecraft/saves/ for the Session 37 Tier-4 manual verification).
# See research/scale_tier4_proposal.md §3.11 + DECISIONS.md 2026-07-04
# "Scale Tier-4 scope (v0.2 work item #2)".
!tests/manual/sponza_scale_tier4_world/
!tests/manual/sponza_scale_tier4_world/level.dat
!tests/manual/sponza_scale_tier4_world/region/
!tests/manual/sponza_scale_tier4_world/region/*.mca

