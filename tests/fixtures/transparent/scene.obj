# objtomc transparent-branch Tier-4 fixture.
# Hand-written per research/transparent_tier4_proposal.md §1.6.
# See DECISIONS.md 2026-07-04 "Transparent branch Tier-4 scope
# (v0.2 work item #1.1)".
# Fixture license: project-inherited (see OPEN_QUESTIONS.md 2026-06-18
# "Project license declaration"); no external upstream, no LICENSE file
# needed.
#
# Geometry: 1 floor + 2 transparent front walls + 2 opaque back walls
#           = 5 quads = 10 triangles across 4 distinct materials.
# Bounding box: X in [0, 2], Y in [0, 2], Z in [0, 2] — 64 voxels per
# axis at voxel_size 0.0313. Scene layout: maintainer spawns at world
# (32, -59, 4) facing south (+Z), sees front transparent walls at
# world Z=16, and (through them) opaque back walls at world Z=48.

mtllib scene.mtl

# Floor corners at Y=0 (opaque_white)
v 0.0 0.0 0.0
v 2.0 0.0 0.0
v 2.0 0.0 2.0
v 0.0 0.0 2.0

# Front wall corners at Z=0.5 (transparent row)
v 0.0 0.0 0.5
v 1.0 0.0 0.5
v 2.0 0.0 0.5
v 0.0 2.0 0.5
v 1.0 2.0 0.5
v 2.0 2.0 0.5

# Back wall corners at Z=1.5 (opaque backing row)
v 0.0 0.0 1.5
v 1.0 0.0 1.5
v 2.0 0.0 1.5
v 0.0 2.0 1.5
v 1.0 2.0 1.5
v 2.0 2.0 1.5

# Floor (white; extends full extent so the player has something to
# stand on both before and behind the front walls)
usemtl opaque_white
f 1 2 3
f 1 3 4

# Front-left transparent wall (clear glass; X in [0,1], Y in [0,2], Z=0.5)
usemtl clear_glass
f 5 6 9
f 5 9 8

# Front-right transparent wall (red glass; X in [1,2], Y in [0,2], Z=0.5)
usemtl red_glass
f 6 7 10
f 6 10 9

# Back-left opaque red (visible THROUGH clear_glass; X in [0,1], Z=1.5)
usemtl opaque_red
f 11 12 15
f 11 15 14

# Back-right opaque white (visible THROUGH red_glass; X in [1,2], Z=1.5)
usemtl opaque_white
f 12 13 16
f 12 16 15
