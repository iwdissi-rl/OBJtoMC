mtllib materials.mtl

# Six vertices — two non-overlapping triangles.
v 0.0 0.0 0.0
v 1.0 0.0 0.0
v 0.0 1.0 0.0
v 2.0 0.0 0.0
v 3.0 0.0 0.0
v 2.0 1.0 0.0

usemtl MatA
f 1 2 3

usemtl MatB
f 4 5 6
